# Crainbow CBT — configuration template
#
# Copy this file to .env and fill in real values:
#   copy .env.example .env        (Windows)
#   cp .env.example .env           (macOS/Linux)
#
# .env is loaded automatically by app.py on every startup (python-dotenv). A
# value already set in the real environment always wins over .env, so a
# throwaway test/CI run that exports CRAINBOW_DB itself is never affected.
#
# Unlike .env, this file contains no real secrets and is safe to share or keep
# in version control.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# 'development' or 'production'. In production, BRIGHTSTARS_SECRET below is
# required to be at least 32 characters, or the app refuses to start.
BRIGHTSTARS_ENV=development

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Flask's session-signing secret. If this is left blank, a new random secret
# is generated every time the app starts, which silently logs out every
# signed-in user on every restart. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
BRIGHTSTARS_SECRET=CHANGE_ME_64_HEX_CHARACTERS

# ---------------------------------------------------------------------------
# Initial Super Admin — read ONLY the first time the app initialises a
# database that has no Super Admin account yet.
# ---------------------------------------------------------------------------
# Once a Super Admin exists in the database, both of these are ignored on
# every future startup, no matter what you change them to here — the database
# is authoritative from that point on. To rotate the password later, use the
# admin UI or reset it directly against the database; editing these lines
# will not do it.
CRAINBOW_SUPERADMIN_USERNAME=superadmin
CRAINBOW_ADMIN_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Database & data paths (optional — leave commented out for the normal
# single-deployment layout, where the database and bank data live alongside
# app.py as cbt.db and data/)
# ---------------------------------------------------------------------------
# CRAINBOW_DB=C:\path\to\cbt.db
# CRAINBOW_DATA=C:\path\to\data

# ---------------------------------------------------------------------------
# Multi-tenancy — many schools on one Brightstars Academics deployment.
# Off by default: leave all of this commented out for a single-school install.
# See docs/architecture/MULTI_TENANCY.md. PRODUCTION USES POSTGRESQL; the
# SQLite defaults below are for local development only.
# ---------------------------------------------------------------------------
# BRIGHTSTARS_MULTITENANT=1
# The domain every school's portal address is issued under. A school created
# with the code "alpha" is reachable at alpha.<this domain> immediately; the
# school then points a CNAME record on its own domain at that address.
# Default: localhost (so alpha.localhost works in development).
# BRIGHTSTARS_PORTAL_DOMAIN=schools.brightstars.example
# The platform registry (schools, their domains, platform admins). Default is a
# SQLite file next to app.py. In production, e.g.:
#   postgresql+psycopg://user:password@host/brightstars_platform
# BRIGHTSTARS_PLATFORM_DB=
# Hostnames (comma-separated, no ports) that serve the platform console rather
# than a school. Default: platform.localhost
# BRIGHTSTARS_PLATFORM_HOSTS=platform.brightstars.example
# Each school's question banks and uploads (and, for SQLite, its database).
# BRIGHTSTARS_TENANTS_DIR=C:\path\to\tenants
# Seconds a hostname -> school lookup is cached per process. Suspending a
# school reaches every worker within this time. 0 disables the cache.
# BRIGHTSTARS_REGISTRY_CACHE_SECONDS=10
# A school's own database is set per school with --db-url when it is created
# (use env:VARIABLE_NAME to keep the password out of the registry).

# ---------------------------------------------------------------------------
# Upload and request size limits
# ---------------------------------------------------------------------------
# Maximum size, in bytes, of a single uploaded image (photos, question images).
BRIGHTSTARS_MAX_UPLOAD_BYTES=5242880
# Maximum size, in bytes, of any single incoming request (Flask's
# MAX_CONTENT_LENGTH). Must be at least as large as the upload limit above.
BRIGHTSTARS_MAX_REQUEST_BYTES=8388608

# ---------------------------------------------------------------------------
# Email (SMTP) — used to send payment receipts and password-reset links.
# Leave BRIGHTSTARS_SMTP_HOST blank to disable email delivery.
# ---------------------------------------------------------------------------
BRIGHTSTARS_SMTP_HOST=smtp.example.com
BRIGHTSTARS_SMTP_PORT=587
BRIGHTSTARS_SMTP_USER=school@example.com
BRIGHTSTARS_SMTP_PASSWORD=CHANGE_ME
# Defaults to BRIGHTSTARS_SMTP_USER if left blank.
BRIGHTSTARS_SMTP_FROM=school@example.com
# 1 to use STARTTLS (almost always correct), 0 to disable it. Only applies on
# ports other than 465 — see BRIGHTSTARS_SMTP_SSL below.
BRIGHTSTARS_SMTP_STARTTLS=1
# Port 465 always connects with implicit TLS (SMTP_SSL) automatically; any
# other port connects plain and upgrades via STARTTLS. Leave this blank to
# use that default. Set to 1 or 0 only if your provider's port doesn't follow
# the convention (e.g. a host that serves implicit TLS on a non-465 port).
BRIGHTSTARS_SMTP_SSL=

# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API — used to send payment receipts by WhatsApp.
# Obtain these from the school's Meta/WhatsApp Business setup. Leave
# BRIGHTSTARS_WHATSAPP_TOKEN blank to disable WhatsApp delivery.
# ---------------------------------------------------------------------------
BRIGHTSTARS_WHATSAPP_TOKEN=CHANGE_ME
BRIGHTSTARS_WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
BRIGHTSTARS_WHATSAPP_GRAPH_VERSION=v23.0

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port used by `python app.py` (the built-in development server).
PORT=5000
