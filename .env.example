# Brightstars Academics — configuration
#
# Copy this file to .env and fill it in. .env is gitignored; never commit it.
# A variable already set in the real environment always wins over this file.

# ---------------------------------------------------------------------------
# Platform (required)
# ---------------------------------------------------------------------------
# PostgreSQL URL of the platform registry: which schools exist, their
# addresses, and the platform administrators. Every school then gets its own
# PostgreSQL database on the same server, named brightstars_<school-code>.
#
# The role needs permission to CREATE DATABASE, since schools are created on
# demand. Locally, the postgres superuser is fine.
BRIGHTSTARS_PLATFORM_DB=postgresql+psycopg://{user}:{password}@{host}:{port}/{database_name}?sslmode=require

# Your PostgreSQL default database is "postgres" - this tells the code which
# database is guaranteed to exist so it can create a new school's database against it.
# change if otherwise, e.g. if you use Aiven's default "defaultdb" instead of "postgres".
BRIGHTSTARS_PG_MAINTENANCE_DB=postgres

# Hostnames (comma-separated, no ports) that serve the platform console at
# /platform. Opening one of them at "/" goes straight to the console's sign-in
# page. No school is ever served on these. Point the platform's own marketing
# site (e.g. brightstars.com) at separate hosting, and use a subdomain of it,
# such as platform.brightstars.com, here.
BRIGHTSTARS_PLATFORM_HOSTS=platform.localhost

# Every school is issued a portal address of <school-code>.<this domain> the
# moment it is created. Schools point a CNAME on their own domain at it.
# In development, "localhost" makes a school reachable at <code>.localhost.
BRIGHTSTARS_PORTAL_DOMAIN=localhost

# Where each school's files live: <this>/<school-code>/{data,uploads}
BRIGHTSTARS_TENANTS_DIR=tenants

# Flask session-signing secret. Leaving it blank generates a new one on every
# restart, which signs everybody out. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
BRIGHTSTARS_SECRET=

# development or production. In production BRIGHTSTARS_SECRET must be at least
# 32 characters or the application refuses to start, and session cookies are
# marked Secure.
BRIGHTSTARS_ENV=development

# Port for the built-in development server.
PORT=5000

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Seconds a hostname -> school lookup is cached in each worker process. This
# bounds how long suspending a school takes to reach every worker. 0 disables.
BRIGHTSTARS_REGISTRY_CACHE_SECONDS=10

# Seconds a school's computed branding (name, colours, logo, contact details) is cached in
# each worker process. Saving a school's branding clears it immediately in the worker that
# saved it; this only bounds how long a *different* worker keeps serving the old values.
# 0 disables.
BRIGHTSTARS_BRANDING_CACHE_SECONDS=10

# Place schools' databases somewhere other than beside the registry. {slug} is
# the school's code and {db} its full database name.
# BRIGHTSTARS_SCHOOL_DB_TEMPLATE=postgresql+psycopg://user:password@db-host:5432/{db}

# How many reverse proxies (nginx, Caddy, a load balancer...) stand between the internet and this
# application. 0, the default, means none: the address a visitor appears to come from is the
# connection's own, and the X-Forwarded-For / X-Forwarded-Proto headers are ignored, because
# anyone can write them. Set it to 1 when exactly one proxy of yours is in front (the usual case),
# 2 when there are two in a row, and so on (at most 5). Then the visitor's real address is used in
# the audit log and the sign-in limits, and links in emails use https. Too high a number lets a
# visitor forge their address; too low records the proxy's address for everyone. The Host header is
# never taken from a proxy: it chooses the school, so the proxy must pass it on unchanged.
BRIGHTSTARS_TRUSTED_PROXIES=0

# Maximum size in bytes of a single uploaded image, and of any single request.
# The request limit must be at least as large as the upload limit.
BRIGHTSTARS_MAX_UPLOAD_BYTES=5242880
BRIGHTSTARS_MAX_REQUEST_BYTES=8388608

# ---------------------------------------------------------------------------
# Email (SMTP) — payment receipts and password-reset links.
# Leave BRIGHTSTARS_SMTP_HOST blank to disable email delivery.
# This is the platform's SHARED account, used by any school that has not set up its own under
# "Email & WhatsApp" in its admin area. A school that has set up its own never uses this one.
# ---------------------------------------------------------------------------
BRIGHTSTARS_SMTP_HOST=
BRIGHTSTARS_SMTP_PORT=465
BRIGHTSTARS_SMTP_USER=
BRIGHTSTARS_SMTP_PASSWORD=
# Defaults to BRIGHTSTARS_SMTP_USER if left blank.
BRIGHTSTARS_SMTP_FROM=
# 1 to use STARTTLS (almost always correct), 0 to disable it.
BRIGHTSTARS_SMTP_STARTTLS=1
# Port 465 always uses implicit TLS automatically; any other port connects
# plain and upgrades via STARTTLS. Leave blank for that default, and set it
# only if your provider serves implicit TLS on a non-465 port.
BRIGHTSTARS_SMTP_SSL=

# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API — receipt delivery.
# Leave BRIGHTSTARS_WHATSAPP_TOKEN blank to disable it. Like the mail server above, this is the
# shared account; a school can set up its own.
# ---------------------------------------------------------------------------
BRIGHTSTARS_WHATSAPP_TOKEN=
BRIGHTSTARS_WHATSAPP_PHONE_NUMBER_ID=
BRIGHTSTARS_WHATSAPP_GRAPH_VERSION=v20.0

# ---------------------------------------------------------------------------
# Optional. The key schools' saved mail and WhatsApp passwords and tokens are
# encrypted under. Left blank, one is derived from BRIGHTSTARS_SECRET, which means
# rotating that secret makes every saved credential unreadable (schools would re-enter
# them). Set this to keep them independent of it, and never change it once schools
# have saved credentials. Any long random string will do.
# ---------------------------------------------------------------------------
BRIGHTSTARS_DELIVERY_KEY=

# ---------------------------------------------------------------------------
# Optional. The Chrome or Chromium program that draws a candidate's result image.
# Found automatically on Windows and under the usual names on Linux and macOS; set
# this only if it lives somewhere else.
# ---------------------------------------------------------------------------
# BRIGHTSTARS_CHROME=

# ---------------------------------------------------------------------------
# Where a school's uploads, question banks and numbering rules are kept.
# 'local' (the default) is a folder on this machine (BRIGHTSTARS_TENANTS_DIR).
# 's3' is an S3-compatible object store: real AWS S3, or Cloudflare R2, Backblaze B2,
# DigitalOcean Spaces or MinIO by also setting BRIGHTSTARS_S3_ENDPOINT_URL. Needed
# whenever the application server's own disk is not persistent, or is not shared
# across more than one application server.
# ---------------------------------------------------------------------------
BRIGHTSTARS_STORAGE_BACKEND=
#
# Required when BRIGHTSTARS_STORAGE_BACKEND=s3:
BRIGHTSTARS_S3_BUCKET=
BRIGHTSTARS_S3_ACCESS_KEY_ID=
BRIGHTSTARS_S3_SECRET_ACCESS_KEY=
#
# Optional (s3 backend only):
# Leave blank for real AWS S3. Set to your provider's endpoint for an S3-compatible
# one, e.g. https://<account-id>.r2.cloudflarestorage.com (Cloudflare R2).
BRIGHTSTARS_S3_ENDPOINT_URL=
# Region your bucket lives in. Some S3-compatible providers ignore this ('auto' is
# the common placeholder they expect).
BRIGHTSTARS_S3_REGION=auto

# An optional prefix every school's files are namespaced under in the bucket, so one
# bucket can be shared with other uses.
BRIGHTSTARS_S3_PREFIX=

# How many bytes of uploaded-file content (images, signatures, attachments) each worker process
# keeps in memory, so a second request for the same file - by any visitor, not just the one who
# asked first - is answered without going back to the bucket. 0 disables it.
BRIGHTSTARS_UPLOAD_CACHE_BYTES=67108864 
