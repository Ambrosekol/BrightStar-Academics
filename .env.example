# Brightstars Academics — configuration
#
# Copy this file to .env and fill it in. .env is gitignored; never commit it.
# A variable already set in the real environment always wins over this file.

# ---------------------------------------------------------------------------
# Platform (required)
# ---------------------------------------------------------------------------
# PostgreSQL URL of the platform registry: which schools exist, their
# addresses, and the platform administrators. Every school then gets its own
# PostgreSQL database on the same server, named brightstars_<school-code>.
#
# The role needs permission to CREATE DATABASE, since schools are created on
# demand. Locally, the postgres superuser is fine.
BRIGHTSTARS_PLATFORM_DB=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/brightstars_platform

# Hostnames (comma-separated, no ports) that serve the platform's own website
# and the console at /platform. No school is ever served on these.
BRIGHTSTARS_PLATFORM_HOSTS=platform.localhost

# Every school is issued a portal address of <school-code>.<this domain> the
# moment it is created. Schools point a CNAME on their own domain at it.
# In development, "localhost" makes a school reachable at <code>.localhost.
BRIGHTSTARS_PORTAL_DOMAIN=localhost

# Where each school's files live: <this>/<school-code>/{data,uploads}
BRIGHTSTARS_TENANTS_DIR=tenants

# Flask session-signing secret. Leaving it blank generates a new one on every
# restart, which signs everybody out. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
BRIGHTSTARS_SECRET=CHANGE_ME

# development or production. In production BRIGHTSTARS_SECRET must be at least
# 32 characters or the application refuses to start, and session cookies are
# marked Secure.
BRIGHTSTARS_ENV=development

# Port for the built-in development server.
PORT=5000

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Seconds a hostname -> school lookup is cached in each worker process. This
# bounds how long suspending a school takes to reach every worker. 0 disables.
# BRIGHTSTARS_REGISTRY_CACHE_SECONDS=10

# Place schools' databases somewhere other than beside the registry. {slug} is
# the school's code and {db} its full database name.
# BRIGHTSTARS_SCHOOL_DB_TEMPLATE=postgresql+psycopg://user:password@db-host:5432/{db}

# Maximum size in bytes of a single uploaded image, and of any single request.
# The request limit must be at least as large as the upload limit.
BRIGHTSTARS_MAX_UPLOAD_BYTES=5242880
BRIGHTSTARS_MAX_REQUEST_BYTES=8388608

# ---------------------------------------------------------------------------
# Email (SMTP) — payment receipts and password-reset links.
# Leave BRIGHTSTARS_SMTP_HOST blank to disable email delivery.
# These are deployment-wide; per-school delivery settings are not built yet.
# ---------------------------------------------------------------------------
BRIGHTSTARS_SMTP_HOST=
BRIGHTSTARS_SMTP_PORT=587
BRIGHTSTARS_SMTP_USER=
BRIGHTSTARS_SMTP_PASSWORD=
# Defaults to BRIGHTSTARS_SMTP_USER if left blank.
BRIGHTSTARS_SMTP_FROM=
# 1 to use STARTTLS (almost always correct), 0 to disable it.
BRIGHTSTARS_SMTP_STARTTLS=1
# Port 465 always uses implicit TLS automatically; any other port connects
# plain and upgrades via STARTTLS. Leave blank for that default, and set it
# only if your provider serves implicit TLS on a non-465 port.
BRIGHTSTARS_SMTP_SSL=

# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API — receipt delivery.
# Leave BRIGHTSTARS_WHATSAPP_TOKEN blank to disable it.
# ---------------------------------------------------------------------------
BRIGHTSTARS_WHATSAPP_TOKEN=
BRIGHTSTARS_WHATSAPP_PHONE_NUMBER_ID=
BRIGHTSTARS_WHATSAPP_GRAPH_VERSION=v20.0
